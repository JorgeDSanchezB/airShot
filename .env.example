# AirShot — variables de entorno (copiar a .env)

# SQLite de la app. La ruta es relativa a prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Obligatoria en producción: cifra las API keys de proveedores (AES-256-GCM).
# Acepta base64 de 32 bytes o una frase (se deriva con scrypt).
AIRSHOT_SECRET_KEY=

# Opcional: si se define, /api/v1/** exige sesión; desbloquea en /unlock.
# Si queda vacía, la API opera en modo abierto (solo recomendable en local).
AIRSHOT_API_TOKEN=
